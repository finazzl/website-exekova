# Copy to .env.local. Public values are bundled at build time; rebuild after changes.
# Use Exekova's own keys: Truvon's keys are tied to its inbox and allowed domains.

# Contact delivery priority: explicit endpoint -> Web3Forms -> /api/contact.
# Only unconfigured local development falls back to an email draft.
NEXT_PUBLIC_CONTACT_ENDPOINT=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public GA4 property. Analytics loads only after the visitor opts in; blank disables it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R33H6YFCH2

# Server-only values for the built-in Turnstile + Resend receiver.
# For Cloudflare, configure these on the Worker; .env.local is NOT deployed.
# Never prefix these secrets with NEXT_PUBLIC_.
TURNSTILE_SECRET=
RESEND_API_KEY=
LEAD_TO=connect@exekova.com
LEAD_FROM=website@exekova.com
